{
    "keyboard_name": "Helm",
    "manufacturer": "duketopceo",
    "url": "https://github.com/duketopceo/helm",
    "maintainer": "duketopceo",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "usb": {
        "vid": "0x484D",
        "pid": "0x0001",
        "device_version": "1.0.0"
    },
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "encoder": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        "direct": [
            ["GP26", "GP27", "GP28", null],
            ["GP29", "GP6",  "GP7",  "GP2"]
        ]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP4", "pin_b": "GP3", "resolution": 4}
        ]
    },
    "bootmagic": {
        "matrix": [0, 0]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0, "label": "K00"},
                {"matrix": [0, 1], "x": 1, "y": 0, "label": "K01"},
                {"matrix": [0, 2], "x": 2, "y": 0, "label": "K02"},
                {"matrix": [1, 0], "x": 0, "y": 1, "label": "K10"},
                {"matrix": [1, 1], "x": 1, "y": 1, "label": "K11"},
                {"matrix": [1, 2], "x": 2, "y": 1, "label": "K12"},
                {"matrix": [1, 3], "x": 3, "y": 1, "label": "KNOB"}
            ]
        }
    }
}
